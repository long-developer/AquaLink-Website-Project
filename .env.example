GEMINI_KEY_FREE=your_free_key_here // this is the free key for Gemini API, you can get it from the Gemini website
GEMINI_KEY_PAID=your_paid_key_here // this is the paid key for Gemini API, you can get it from the Gemini website
PORT=3000
//or you can use a different port if you prefer
// Note:: Make your self-hosted instance of Gemini by following the instructions in the README.md file.
// you can get the free key from the Gemini website (https://gemini.google.com/), and the paid key if you have a subscription.
// Note:: Make sure to keep your keys secure and do not share them publicly.
